APP_NAME=EventSourceDemo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite: un archivo en database/database.sqlite, sin contenedor de base.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Driver por defecto (ver config/broadcasting.php). Sus callbacks de
# routes/channels.php los heredan los otros drivers.
BROADCAST_CONNECTION=sse

# Drivers candidatos por los que sale UserNotification. Con los tres, el mismo
# evento llega por cada transporte y se comparan lado a lado en la home.
BROADCAST_FANOUT=sse,apigateway,mercure

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Vacio a proposito: asi las claves en Redis son literales y se pueden
# inspeccionar con `redis-cli XRANGE sse:stream:private-user.1 - +`.
REDIS_PREFIX=

# HS256 exige una clave de al menos 32 bytes (firebase/php-jwt lo valida).
JWT_SECRET=dev-only-secret-change-me-min-32-bytes-long
JWT_ALGO=HS256
JWT_TTL=3600
JWT_ISSUER=eventsource-demo

# --- Driver sse (SSE desde PHP + Redis Streams) ---
# Cuanto bloquea cada XREAD antes de mandar un heartbeat.
SSE_BLOCK_MS=15000
# Vida maxima de una conexion; al cerrarse el cliente reconecta con Last-Event-ID.
SSE_MAX_LIFETIME=600
SSE_RETRY_MS=3000
SSE_STREAM_RETAIN=100

# --- Driver apigateway (API Gateway WebSocket + DynamoDB) ---
# En local: el emulador gateway-local y DynamoDB Local (claves de mentira).
# En AWS: los Outputs de infra/template.yaml y credenciales reales (o rol).
WS_MANAGEMENT_ENDPOINT=http://gateway-local:3001
DYNAMODB_ENDPOINT=http://dynamodb:8000
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
WS_TABLE_PREFIX=ws_
WS_EVENTS_TTL=86400
WS_CONNECTION_TTL=10800

# Secreto que API Gateway manda en X-Gateway-Secret a /api/ws/gateway/*.
WS_GATEWAY_SECRET=dev-only-gateway-secret
# Vida del ticket para abrir el WebSocket, en segundos.
WS_TICKET_TTL=60

# --- Driver mercure (nativo de Laravel, hub Mercure integrado en FrankenPHP) ---
# Donde publica Laravel (dentro del contenedor) y donde se suscribe el navegador.
MERCURE_URL=http://localhost:8000/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:8000/.well-known/mercure
# Las claves JWT las define docker-compose.yml: el hub (Caddy) las lee del
# entorno del contenedor y Laravel tambien. Fuera de docker, definilas aca.
# MERCURE_PUBLISHER_JWT_KEY=
# MERCURE_SUBSCRIBER_JWT_KEY=
# Vida de la cookie de suscriptor, en minutos; el hub no reconsulta a Laravel
# mientras valga.
MERCURE_SUBSCRIBE_EXPIRATION=60
# Sin prefijo __Secure-: el entorno local es HTTP. Igual que en el Caddyfile.
MERCURE_COOKIE_NAME=mercureAuthorization
# Claim iss de los tokens; tiene que coincidir con el bloque issuer del hub.
MERCURE_ISSUER=http://localhost:8000

CORS_ALLOWED_ORIGINS=http://localhost:4200

MAIL_MAILER=log

{
	skip_install_trust
	auto_https off
	admin off

	frankenphp {
		# Modo clasico (sin worker): FrankenPHP atiende cada peticion en un hilo
		# propio. Como una conexion SSE ocupa su hilo durante toda su vida, este
		# numero es literalmente el techo de streams simultaneos que soporta el
		# contenedor para el driver 'sse' (ver «Límites» en el README). El hub
		# Mercure de abajo no consume estos hilos.
		num_threads 64
	}
}

:8000 {
	root /app/public

	# A proposito NO usamos `encode`: comprimir un text/event-stream agrega
	# buffering en el camino y es la causa mas comun de "el navegador no recibe
	# nada hasta que se cierra la conexion".

	# `route` respeta el orden escrito: /.well-known/mercure lo atiende el hub
	# antes de llegar a PHP; todo lo demas sigue a Laravel.
	route {
		# Hub Mercure del driver 'mercure'. Es Go dentro del mismo binario:
		# cada suscriptor es una goroutine, no uno de los num_threads de PHP.
		mercure {
			# Historial en disco: con el se reponen eventos por Last-Event-ID.
			# Efimero como Redis (sin volumen), alcanza para reconexiones.
			transport bolt {
				path /data/mercure.db
				size 1000
			}

			# Emisor de confianza (Mercure 1.0): el hub solo acepta tokens cuyo
			# claim iss sea este valor, y los valida con sus claves HS256.
			# Laravel firma con las mismas y el mismo iss (ver
			# config/broadcasting.php); vienen del environment del contenedor
			# y se sustituyen al cargar el Caddyfile ({$VAR}).
			issuer {$MERCURE_ISSUER:http://localhost:8000} {
				publisher {
					jwt {$MERCURE_PUBLISHER_JWT_KEY} HS256
				}
				subscriber {
					jwt {$MERCURE_SUBSCRIBER_JWT_KEY} HS256
				}
			}

			# El navegador se suscribe desde el dev server de Angular.
			cors_origins {$MERCURE_CORS_ORIGINS:http://localhost:4200}

			# Cookie donde Laravel deja el JWT de suscriptor (POST
			# /api/broadcasting/mercure/auth). Mismo nombre que cookie_name en
			# config/broadcasting.php; sin prefijo __Secure- porque es HTTP.
			cookie_name {$MERCURE_COOKIE_NAME:mercureAuthorization}

			# Sin `anonymous`: no se puede suscribir nadie sin JWT, y las
			# publicaciones privadas solo llegan a quien tenga el topic.
		}

		php_server
	}
}
